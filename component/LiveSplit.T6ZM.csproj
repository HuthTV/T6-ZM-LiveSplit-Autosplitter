<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>LiveSplit.T6ZM</AssemblyName>
    <RootNamespace>LiveSplit.T6ZM</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>0.1.0</Version>
    <!-- compile references, -p:LiveSplitDir=... -->
    <LiveSplitDir Condition="'$(LiveSplitDir)' == ''">$(USERPROFILE)\Desktop\LS</LiveSplitDir>
    <NativeDir Condition="'$(NativeDir)' == ''">$(MSBuildThisFileDirectory)..\build\native</NativeDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="LiveSplit.Core" HintPath="$(LiveSplitDir)\LiveSplit.Core.dll" Private="false" />
    <Reference Include="UpdateManager" HintPath="$(LiveSplitDir)\UpdateManager.dll" Private="false" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(NativeDir)\x86\t6zm_reader.dll" LogicalName="t6zm_reader.x86.dll" />
    <EmbeddedResource Include="$(NativeDir)\x64\t6zm_reader.dll" LogicalName="t6zm_reader.x64.dll" />
  </ItemGroup>
  <Target Name="CheckNativeReaders" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(NativeDir)\x86\t6zm_reader.dll') Or !Exists('$(NativeDir)\x64\t6zm_reader.dll')"
           Text="The native readers are missing from $(NativeDir); build with build.bat." />
  </Target>
</Project>
